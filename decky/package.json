{
  "name": "oxp3deck",
  "version": "0.1.0",
  "description": "OXP3 Deck - oxp3-tool and xess-xmx-linux for the ONEXPLAYER 3 in one Quick Access panel",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -t .",
    "zip": "python3 tools/build_zip.py"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.16.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "rollup": "4.53.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.5.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
